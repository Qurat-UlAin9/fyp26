# Express/Supabase API configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PORT=5000
CORS_ORIGIN=*

# Optional configuration for the standalone Python assessment service.
# Use a different port from the Express API when running both services.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aimdb
